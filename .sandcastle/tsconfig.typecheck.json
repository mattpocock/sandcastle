{
  // The repo's own tooling: agent workflows, the verify harness, the test
  // drivers. `npm run lint` type-checks it and holds the errors, per file ×
  // TS code, to scripts/typecheck-baseline.json (scripts/lint-ratchet.ts).
  //
  // - Bundler resolution: the scripts run through tsx, which takes
  //   extensionless relative imports. NodeNext rejects them, and each
  //   unresolved import cascades into implicit-any errors that are not real.
  // - @ai-hero/sandcastle resolves to src, as in tests/tsconfig.json, so no
  //   build is needed.
  // - Not named tsconfig.json: oxlint's type-aware rules would pick it up for
  //   these files and their counts in scripts/lint-baseline.json would move.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "..",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "plugins": [],
    "paths": {
      "@ai-hero/sandcastle": ["../src/index.ts"],
      "@ai-hero/sandcastle/sandboxes/*": ["../src/sandboxes/*.ts"]
    }
  },
  "include": ["**/*.ts", "../src/vercel-sandbox.d.ts"],
  "exclude": ["worktrees", "logs"]
}
