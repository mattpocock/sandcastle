{
  // The e2e tests see Sandcastle the way a user does: by package name. These
  // paths mirror the aliases in vitest.config.ts, so the names resolve to the
  // src entry files without a build.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@ai-hero/sandcastle": ["../src/index.ts"],
      "@ai-hero/sandcastle/sandboxes/*": ["../src/sandboxes/*.ts"],
      "@ai-hero/sandcastle/v1": ["../src/v1.ts"],
      "@ai-hero/sandcastle/v1/testing": ["../src/v1/testing.ts"],
      "@ai-hero/sandcastle/v1/tasks": ["../src/v1/tasks.ts"],
      "@ai-hero/sandcastle/v1/sandboxes/daytona": [
        "../src/v1/sandboxes/daytona.ts"
      ]
    }
  },
  "include": ["**/*.ts"]
}
